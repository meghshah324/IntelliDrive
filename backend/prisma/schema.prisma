// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String

  storageLimit Int     
  usedStorage  Int      @default(0)

  nodes        Node[]   @relation("UserNodes")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Node {
  id        String   @id @default(uuid())
  name      String
  type      NodeType

  // Only for FILE
  key       String?  @unique
  size      Int?
  mimeType  String?

  userId    String
  parentId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User     @relation("UserNodes", fields: [userId], references: [id], onDelete: Cascade)

  parent    Node?    @relation("NodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Node[]   @relation("NodeChildren")

  @@index([userId])
  @@index([parentId])
}

enum NodeType {
  FILE
  FOLDER
}