generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model node {
  id         String    @id
  name       String
  type       node_type
  key        String?   @unique(map: "Node_key_key")
  size       Int?
  mimeType   String?
  userId     String
  parentId   String?
  isTrashed  Boolean   @default(false)
  trashedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  node       node?     @relation("nodeTonode", fields: [parentId], references: [id], onDelete: Cascade, map: "Node_parentId_fkey")
  other_node node[]    @relation("nodeTonode")
  user       user      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Node_userId_fkey")
  star       star[]

  @@index([parentId], map: "Node_parentId_idx")
  @@index([userId], map: "Node_userId_idx")
  @@index([isTrashed], map: "Node_isTrashed_idx")
}

model star {
  id        String   @id
  userId    String
  nodeId    String
  createdAt DateTime @default(now())
  node      node     @relation(fields: [nodeId], references: [id], onDelete: Cascade, map: "Star_nodeId_fkey")
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Star_userId_fkey")

  @@unique([userId, nodeId], map: "Star_userId_nodeId_key")
  @@index([nodeId], map: "Star_nodeId_idx")
  @@index([userId], map: "Star_userId_idx")
}

model user {
  id           String   @id
  name         String
  email        String   @unique(map: "User_email_key")
  storageLimit Int
  usedStorage  Int      @default(0)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  node         node[]
  star         star[]
}

enum node_type {
  FILE
  FOLDER
}
